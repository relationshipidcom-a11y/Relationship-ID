# Firebase Web App config from Firebase Console -> Project settings -> Your apps -> Web app
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
# Optional (Google Analytics is not enabled for this project):
# VITE_FIREBASE_MEASUREMENT_ID=""

# Firebase App Check (reCAPTCHA Enterprise)
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=""

# Server-side project id used only to verify Firebase ID tokens on API requests.
# In AI Studio you can set this to the same value as VITE_FIREBASE_PROJECT_ID.
FIREBASE_PROJECT_ID=""

# AI Studio / Cloud runtime value. Leave as provided by the environment when available.
APP_URL=""

# Number of proxies in front of the server. Cloud Run direct = 1. Adjust at deployment.
TRUST_PROXY_HOPS=1

# Server-only secret. Used by Cloud Scheduler to trigger cleanup. Never use a VITE_ prefix.
RECONCILE_SECRET=

# Server-only secret for HMAC-SHA256 contact hashing. Min 32 chars. Never use a VITE_ prefix. Never rotate after real users exist.
CONTACT_HASH_SECRET=

# Twilio Verify via SMS (optional, server-side only)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SID=""
